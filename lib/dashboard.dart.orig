class GapPreviewPage extends StatefulWidget {
  final JournalController controller;
  final int year;
  const GapPreviewPage({
    super.key,
    required this.controller,
    required this.year,
  });
  @override
  State<GapPreviewPage> createState() => _GapPreviewPageState();
}

class _GapPreviewPageState extends State<GapPreviewPage> {
  late final HomeFillPreview _preview;
  bool _busy = false;
  bool _done = false;
  String? _error;
  @override
  void initState() {
    super.initState();
    _preview = HomeFillPreview(
      widget.controller.snapshot,
      widget.year,
      widget.controller.today(),
    );
  }

  Future<void> _save() async {
    if (_busy || _done) return;
    setState(() {
      _busy = true;
      _error = null;
    });
    try {
      final next = _preview.confirm(
        widget.controller.snapshot,
        widget.controller.today(),
        _newId,
        note: context.l10n.gapFillNote(
          _preview.year,
          countryName(
            context,
            _preview.source.homeCountryCode,
            _preview.source.homeCountry ?? '',
          ),
        ),
      );
      await widget.controller.commit(next);
      if (mounted) {
        setState(() {
          _done = true;
          _busy = false;
        });
      }
    } catch (_) {
      if (mounted) {
        setState(() {
          _busy = false;
          _error = context.l10n.gapsSaveFailed;
        });
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;
    return PopScope(
      canPop: !_busy,
      child: Scaffold(
        appBar: AppBar(title: Text(l10n.gapsTitle)),
        body: SafeArea(
          child: Center(
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 720),
              child: ListView(
                padding: const EdgeInsets.all(20),
                children: [
                  Text(
                    _done ? l10n.gapsDone : l10n.gapsCheckFirst,
                    style: Theme.of(context).textTheme.headlineMedium
                        ?.copyWith(fontWeight: FontWeight.w700),
                  ),
                  const SizedBox(height: 16),
                  Text(
                    l10n.gapsYearHome(
                      _preview.year,
                      countryName(
                        context,
                        _preview.source.homeCountryCode,
                        _preview.source.homeCountry ?? '',
                      ),
                    ),
                  ),
                  const SizedBox(height: 12),
                  Text(l10n.gapsExplain),
                  const SizedBox(height: 20),
                  if (_preview.gaps.isEmpty) Text(l10n.gapsNone),
                  for (final gap in _preview.gaps)
                    Padding(
                      padding: const EdgeInsets.only(bottom: 14),
                      child: Card(
                        child: Padding(
                          padding: const EdgeInsets.all(18),
                          child: Text(
                            '${gap.start.text(context)} — ${gap.end.text(context)}\n'
                            '${l10n.daysCompact(gap.days)}',
                          ),
                        ),
                      ),
                    ),
                  if (_preview.gaps.isNotEmpty) ...[
                    Text(
                      l10n.gapsTotal(
                        l10n.daysCompact(_preview.days),
                        _preview.gaps.length,
                      ),
                      key: const Key('gapCount'),
                      style: Theme.of(context).textTheme.titleLarge,
                    ),
                    const SizedBox(height: 16),
                    Text(
                      _done
                          ? l10n.gapsDoneNote
                          : l10n.gapsConfirmNote(
                              countryName(
                                context,
                                _preview.source.homeCountryCode,
                                _preview.source.homeCountry ?? '',
                              ),
                            ),
                    ),
                    const SizedBox(height: 20),
                    if (_error != null) ...[
                      Text(
                        _error!,
                        key: const Key('gapError'),
                        style: TextStyle(
                          color: Theme.of(context).colorScheme.error,
                        ),
                      ),
                      const SizedBox(height: 16),
                    ],
                    if (!_done)
                      FilledButton(
                        key: const Key('confirmGaps'),
                        onPressed: _busy ? null : _save,
                        child: Text(
                          _busy ? l10n.saving : l10n.gapsConfirmButton,
                        ),
                      ),
                  ],
                  const SizedBox(height: 12),
                  TextButton(
                    onPressed: _busy ? null : () => Navigator.pop(context),
                    child: Text(_done ? l10n.done : l10n.gapsCancel),
                  ),
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}

/// Нижняя панель дня: дата, список записей, переход к записи по id.
class _DayCard extends StatelessWidget {
  final Day day;
  final JournalController controller;
  final ValueChanged<DayEvent> onOpen;
  const _DayCard({
    required this.day,
    required this.controller,
    required this.onOpen,
  });

  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;
    final scheme = Theme.of(context).colorScheme;
    final muted = TextStyle(fontSize: 13, color: scheme.onSurfaceVariant);
    return ListenableBuilder(
      listenable: controller,
      builder: (context, _) {
        final events = eventsOn(controller.snapshot, day, controller.today());
        return SafeArea(
          child: Semantics(
            label: l10n.dayCardSemantics(day.text(context), events.length),
            child: ConstrainedBox(
              constraints: BoxConstraints(
                maxHeight: MediaQuery.sizeOf(context).height * .7,
              ),
              child: Column(
                key: const Key('dayCard'),
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.stretch,
                children: [
                  Padding(
                    padding: const EdgeInsets.fromLTRB(24, 4, 24, 12),
                    child: Text(
                      day.text(context),
                      style: Theme.of(context).textTheme.titleLarge,
                    ),
                  ),
                  if (events.isEmpty)
                    Padding(
                      padding: const EdgeInsets.fromLTRB(24, 0, 24, 24),
                      child: Text(l10n.dayCardEmpty),
                    )
                  else
                    Flexible(
                      child: ListView(
                        shrinkWrap: true,
                        padding: const EdgeInsets.only(bottom: 8),
                        children: [
                          for (final e in events)
                            ListTile(
                              key: Key('dayEvent-${e.id}'),
                              title: Text(
                                e.city.isEmpty
                                    ? countryName(
                                        context,
                                        e.countryCode,
                                        e.country,
                                      )
                                    : '${countryName(context, e.countryCode, e.country)} · ${e.city}',
                              ),
                              subtitle: Text(
                                '${e.isCurrent
                                    ? l10n.dayCardCurrent
                                    : e.kind == TripKind.transit
                                    ? l10n.kindTransit
                                    : l10n.kindStay}'
                                ' · ${e.start.text(context)}'
                                '${e.end == null ? '' : ' — ${e.end!.text(context)}'}',
                                style: muted,
                              ),
                              trailing: const Icon(Icons.chevron_right_rounded),
                              onTap: () => onOpen(e),
                            ),
                        ],
                      ),
                    ),
                  Padding(
                    padding: const EdgeInsets.fromLTRB(24, 4, 24, 16),
                    child: Text(l10n.dayCardHint, style: muted),
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }
}
