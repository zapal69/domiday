/// Напоминание о копии на дашборде: данные только на телефоне, копии не
/// было или она старше месяца. «Позже» откладывает на месяц.
class _BackupNudge extends StatefulWidget {
  final JournalController controller;
  final DateTime Function() now;
  const _BackupNudge({required this.controller, required this.now});
  @override
  State<_BackupNudge> createState() => _BackupNudgeState();
}

class _BackupNudgeState extends State<_BackupNudge> {
  bool _busy = false;

  Future<void> _save() async {
    final l10n = context.l10n;
    final messenger = ScaffoldMessenger.of(context);
    setState(() => _busy = true);
    try {
      final name = await saveBackup(
        context,
        widget.controller,
        BackupScope.of(context)!,
      );
      if (name != null) {
        messenger.showSnackBar(SnackBar(content: Text(l10n.backupSaved(name))));
      }
    } catch (_) {
      if (mounted) {
        await _notice(context, l10n.backupTitle, l10n.backupSaveFailed);
      }
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;
    final scheme = Theme.of(context).colorScheme;
    final last = SettingsController.of(context).settings.lastBackupAt;
    return Card(
      key: const Key('backupNudge'),
      color: scheme.secondaryContainer,
      child: Padding(
        padding: const EdgeInsets.fromLTRB(16, 14, 16, 8),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Icon(
                  Icons.save_alt,
                  size: 20,
                  color: scheme.onSecondaryContainer,
                ),
                const SizedBox(width: 8),
                Expanded(
                  child: Text(
                    l10n.backupNudgeTitle,
                    style: const TextStyle(
                      fontSize: 16,
                      fontWeight: FontWeight.w700,
                    ),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 6),
            Text(
              last == null
                  ? l10n.backupNudgeBodyNever
                  : l10n.backupNudgeBody(dateTimeText(context, last)),
              style: const TextStyle(fontSize: 14),
            ),
            const SizedBox(height: 4),
            Wrap(
              spacing: 4,
              children: [
                TextButton.icon(
                  key: const Key('backupNudgeSave'),
                  onPressed: _busy ? null : _save,
                  icon: const Icon(Icons.save_alt, size: 18),
                  label: Text(l10n.backupSave),
                ),
                TextButton(
                  key: const Key('backupNudgeLater'),
                  onPressed: _busy
                      ? null
                      : () => SettingsController.of(context).snoozeBackupNudge(
                          widget.now().add(AppSettings.backupNudgeAfter),
                        ),
                  child: Text(l10n.backupNudgeLater),
                ),
              ],
            ),
          ],
        ),
      ),
    );
  }
}

/// «Очистить всё»: возврат к первому запуску. Удаление явное и видимое:
/// диалог с числом записей, предложение сначала сохранить копию, красная
/// кнопка. Ничего не удаляется без подтверждения.
class _ClearAllSetting extends StatefulWidget {
  final JournalController controller;
  const _ClearAllSetting({required this.controller});
  @override
  State<_ClearAllSetting> createState() => _ClearAllSettingState();
}

class _ClearAllSettingState extends State<_ClearAllSetting> {
  bool _busy = false;

  Future<void> _clear() async {
    final l10n = context.l10n;
    final settings = SettingsController.of(context);
    final background = BackgroundScope.of(context);
    final navigator = Navigator.of(context);
    final messenger = ScaffoldMessenger.of(context);
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (_) => _ClearAllDialog(
        controller: widget.controller,
        store: BackupScope.of(context),
      ),
    );
    if (confirmed != true || !mounted) return;
    setState(() => _busy = true);
    try {
      // Фоновые задачи снимаются до записи: пустому дневнику проверять
      // нечего; затем дневник и настройки — как при первом запуске.
      await background?.cancel();
      await widget.controller.commit(JournalSnapshot());
      await settings.reset();
      messenger.showSnackBar(SnackBar(content: Text(l10n.clearAllDone)));
      navigator.popUntil((route) => route.isFirst);
    } catch (e) {
      if (mounted) {
        await _notice(context, l10n.clearAllTitle, l10n.clearAllFailed('$e'));
      }
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;
    final scheme = Theme.of(context).colorScheme;
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(l10n.clearAllTitle, style: Theme.of(context).textTheme.titleLarge),
        const SizedBox(height: 8),
        _Helper(
          short: l10n.clearAllShort,
          full: l10n.clearAllHelper,
          id: 'clearAllHelper',
        ),
        const SizedBox(height: 12),
        OutlinedButton.icon(
          key: const Key('clearAll'),
          onPressed: _busy ? null : _clear,
          style: OutlinedButton.styleFrom(
            foregroundColor: scheme.error,
            side: BorderSide(color: scheme.error),
          ),
          icon: const Icon(Icons.delete_forever_outlined),
          label: Text(l10n.clearAllButton),
        ),
      ],
    );
  }
}

class _ClearAllDialog extends StatefulWidget {
  final JournalController controller;
  final BackupStore? store;
  const _ClearAllDialog({required this.controller, required this.store});
  @override
  State<_ClearAllDialog> createState() => _ClearAllDialogState();
}

class _ClearAllDialogState extends State<_ClearAllDialog> {
  bool _busy = false;
  String? _savedName;
  bool _saveFailed = false;

  Future<void> _backup() async {
    setState(() {
      _busy = true;
      _saveFailed = false;
    });
    try {
      final name = await saveBackup(context, widget.controller, widget.store!);
      if (mounted) setState(() => _savedName = name);
    } catch (_) {
      if (mounted) setState(() => _saveFailed = true);
    } finally {
      if (mounted) setState(() => _busy = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;
    final scheme = Theme.of(context).colorScheme;
    final snapshot = widget.controller.snapshot;
    return AlertDialog(
      key: const Key('clearAllDialog'),
      scrollable: true,
      title: Text(l10n.clearAllConfirmTitle),
      content: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(
            l10n.clearAllConfirmBody(
              l10n.recordsCount(
                snapshot.trips.length + snapshot.undated.length,
              ),
            ),
          ),
          if (_savedName != null) ...[
            const SizedBox(height: 12),
            Text(
              l10n.backupSaved(_savedName!),
              key: const Key('clearAllSaved'),
              style: TextStyle(color: scheme.primary),
            ),
          ],
          if (_saveFailed) ...[
            const SizedBox(height: 12),
            Text(l10n.backupSaveFailed, style: TextStyle(color: scheme.error)),
          ],
        ],
      ),
      actions: [
        TextButton(
          onPressed: _busy ? null : () => Navigator.pop(context, false),
          child: Text(l10n.cancel),
        ),
        if (widget.store != null && _savedName == null)
          TextButton(
            key: const Key('clearAllBackup'),
            onPressed: _busy ? null : _backup,
            child: Text(l10n.clearAllBackupFirst),
          ),
        FilledButton(
          key: const Key('clearAllConfirm'),
          onPressed: _busy ? null : () => Navigator.pop(context, true),
          style: FilledButton.styleFrom(
            backgroundColor: scheme.error,
            foregroundColor: scheme.onError,
          ),
          child: Text(l10n.clearAllAction),
        ),
      ],
    );
  }
}

/// Восстановление из файла копии: выбор файла, разбор, подтверждение с
/// числом поездок, полная замена истории одной записью. [pop] — уйти с
/// экрана настроек после успеха (при онбординге экран заменится сам).
Future<void> restoreBackup(
  BuildContext context,
  JournalController controller,
  BackupStore store, {
  required bool pop,
}) async {
  final l10n = context.l10n;
  final messenger = ScaffoldMessenger.of(context);
  try {
    final pick = await store.open();
    if (pick == null || !context.mounted) return;
    final BackupInfo info;
    try {
      info = decodeBackup(pick.contents, controller.today());
    } on BackupError catch (e) {
      await _notice(context, l10n.backupErrorTitle, switch (e.code) {
        BackupErrorCode.notBackup => l10n.backupErrorNotBackup,
        BackupErrorCode.newer => l10n.backupErrorNewer,
        BackupErrorCode.corrupt => l10n.backupErrorCorrupt,
      });
      return;
    }
    if (!context.mounted) return;
    final created = info.createdAt;
    final ok = await _confirm(
      context,
      l10n.backupRestoreTitle,
      l10n.backupRestoreConfirm(
        pick.name,
        l10n.backupTrips(info.snapshot.trips.length),
        created == null
            ? l10n.backupUnknownDate
            : dateTimeText(context, created),
        info.appVersion ?? '?',
        l10n.backupTrips(controller.snapshot.trips.length),
      ),
      l10n.backupRestoreAction,
    );
    if (!ok || !context.mounted) return;
    await controller.commit(info.snapshot);
    if (!context.mounted) return;
    // Восстановились из копии — значит, копия есть: дата последней копии
    // равна дате файла, напоминание «копии ещё не было» не показывается.
    await SettingsController.of(context)
        .markBackup(info.createdAt ?? DateTime.now());
    if (!context.mounted) return;
    messenger.showSnackBar(
      SnackBar(
        content: Text(
          l10n.backupRestored(l10n.backupTrips(info.snapshot.trips.length)),
        ),
      ),
    );
    if (pop) Navigator.pop(context);
  } on JournalError catch (e) {
    if (context.mounted) {
      await _notice(context, l10n.backupErrorTitle, describeError(context, e));
    }
  } catch (_) {
    if (context.mounted) {
      await _notice(context, l10n.backupErrorTitle, l10n.backupErrorCorrupt);
    }
  }
}

/// Импорт истории Google Maps из настроек.
class _ImportSetting extends StatelessWidget {
  final JournalController controller;
  const _ImportSetting({required this.controller});
  @override
  Widget build(BuildContext context) {
    final l10n = context.l10n;
    return Column(
      crossAxisAlignment: CrossAxisAlignment.start,
      children: [
        Text(
          l10n.importSectionTitle,
          style: Theme.of(context).textTheme.titleLarge,
        ),
        const SizedBox(height: 8),
        _Helper(
          short: l10n.importShort,
          full: l10n.importHelper,
          id: 'importHelper',
        ),
        const SizedBox(height: 12),
        FilledButton.tonalIcon(
          key: const Key('importPick'),
          onPressed: () => startTimelineImport(context, controller),
          icon: const Icon(Icons.map_outlined),
          label: Text(l10n.importPick),
        ),
      ],
